---
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import "../css/global.css";
import "../css/md.css";

interface Props {
  title?: string;
  showSidebar?: boolean;
}

const {
  title = "仮",
  showSidebar = false,
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{title}</title>
  </head>

  <body>
    <Header />

    <div
      class:list={[
        "layout",
        {
          "has-sidebar": showSidebar,
        },
      ]}
    >
      {showSidebar && <Sidebar />}

      <main class="main">
        <slot />
      </main>
    </div>
  </body>
</html>